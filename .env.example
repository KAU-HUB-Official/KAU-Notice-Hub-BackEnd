NOTICE_JSON_PATH=./data/kau_official_posts.json
NOTICE_DB_PATH=./data/kau_notice_hub.db
NOTICE_LABELS_PATH=./data/notice_labels.jsonl
NOTICE_AUTO_LABEL_ENABLED=false
NOTICE_AUTO_LABELS_PATH=./data/notice_labels_auto.jsonl
NOTICE_AUTO_LABEL_MODEL=gpt-6-luna
NOTICE_AUTO_LABEL_REASONING_EFFORT=none
NOTICE_AUTO_LABEL_MAX_LLM_CALLS_PER_RUN=100
# 쉼표로 구분한 허용 frontend origin. 아래는 로컬 개발 기본값이다.
# 운영(Lightsail .env)에는 배포된 프론트 origin을 반드시 넣는다. 예:
#   BACKEND_CORS_ORIGINS=https://kau-notice-hub.vercel.app,http://localhost:3000
# 프론트와 API가 같은 도메인(같은 origin)이면 CORS는 발동하지 않는다.
BACKEND_CORS_ORIGINS=http://localhost:3000
# [출시 필수] 반드시 이 서비스 전용 OpenAI "프로젝트 키"를 쓰고, OpenAI 대시보드에서
# 프로젝트 월 하드 캡(Budget limit)을 설정한다. 코드에는 총 지출 상한이 없어서
# 대시보드 캡이 유일한 최종 방어선이다. 캡에 걸리면 챗봇은 로컬 검색 폴백으로 동작한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# /api/chat 분기(키워드 추출) 모델. 추론 모델이 아니면 effort를 비운다.
TRIAGE_MODEL=gpt-6-luna
TRIAGE_REASONING_EFFORT=none
# 공지를 찾은 질문의 답변 모델. history 분기 답변은 OPENAI_MODEL. 추론 모델이 아니면 effort를 비운다.
ANSWER_MODEL=gpt-6-luna
ANSWER_REASONING_EFFORT=none
# 질문자 대상(userGroup)이 있는 요청의 rerank만 이 모델로 보낸다. 추론 모델이 아니면 effort를 비운다.
TARGET_RERANK_MODEL=gpt-6-luna
TARGET_RERANK_REASONING_EFFORT=none
LOG_LEVEL=INFO
# Per-IP 레이트리밋(slowapi, 인메모리). 형식: "<횟수>/<기간>" (minute, hour 등).
# api는 Caddy 뒤에 있고 Caddy가 X-Real-IP를 set 한다. 끄려면 RATE_LIMIT_ENABLED=false.
# 워커 2개라 실효 한도는 설정값의 약 2배(15/minute → 실효 ~30/minute)다.
# per-IP라 교내 NAT 사용자들은 학교 공인 IP 기준으로 이 버킷을 공유한다(향후 세션키 도입 여지).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_NOTICES=120/minute
# BFF(Next.js/Vercel) 프록시가 실제 브라우저 IP를 전달할 때 쓰는 공유 시크릿.
# 프론트의 NOTICE_API_INTERNAL_TOKEN과 같은 값으로 맞춘다(랜덤 문자열). 비우면
# 전달 IP를 무시하고 직접 peer IP만 쓴다 → BFF 뒤에선 레이트리밋이 전체 공용이 됨.
INTERNAL_PROXY_TOKEN=
CONTENT_ENRICHMENT_ENABLED=false
CONTENT_ENRICHMENT_PROVIDER=openai
CONTENT_ENRICHMENT_MODEL=gpt-4.1-mini
CONTENT_ENRICHMENT_FALLBACK_MODEL=gpt-5.5
CONTENT_ENRICHMENT_IMAGE_DETAIL=high
CONTENT_ENRICHMENT_MIN_TEXT_LENGTH=30
CONTENT_ENRICHMENT_MAX_ASSETS_PER_NOTICE=3
CONTENT_ENRICHMENT_MAX_FILE_BYTES=10485760
CONTENT_ENRICHMENT_MAX_CALLS_PER_RUN=50
# 비우면 공개 IP로 해석되는 모든 호스트를 허용한다(localhost·사설 IP는 계속 차단).
# 특정 도메인으로 제한하려면 콤마로 구분해 지정한다.
CONTENT_ENRICHMENT_ALLOWED_DOMAINS=
CRAWLER_SCHEDULER_ENABLED=false
CRAWLER_INTERVAL_SECONDS=10800
CRAWLER_RUN_ON_STARTUP=true
CRAWLER_MAX_PAGES=0
CRAWLER_MIN_RECORDS=1
CRAWLER_MIN_RETAIN_RATIO=0.5
RAG_ENABLED=false
RAG_MAX_REFERENCES=6
RAG_CANDIDATE_POOL=15
RAG_QUERY_EXTRACTION_ENABLED=true
# 챗봇 Q/A 세션 로깅(평가셋·개선용). true이고 요청에 sessionId가 있을 때만 저장한다.
# 운영 notice DB와 분리된 별도 append 전용 SQLite 파일에 쌓인다.
CHAT_LOGGING_ENABLED=false
CHAT_LOG_DB_PATH=./data/chat_sessions.db
# 카카오 로그인. 아래 셋(REST API 키, 허용 redirect URI, JWT_SECRET) 중 하나라도 비어 있으면
# POST /api/auth/kakao만 503을 반환하고 나머지 API는 그대로 동작한다.
# KAKAO_REST_API_KEY: 카카오 개발자 콘솔 > [앱] > [플랫폼 키] > REST API 키
# KAKAO_CLIENT_SECRET: [REST API 키] > [클라이언트 시크릿]. 기본으로 켜져 있어 사실상 필수
# KAKAO_ALLOWED_REDIRECT_URIS: 쉼표 구분. 콘솔에 등록한 Redirect URI와 정확히 같아야 한다.
#   예: http://localhost:3000/auth/kakao/callback,https://kau-notice-hub.app/auth/kakao/callback
# JWT_SECRET: 32자 이상 랜덤 값(openssl rand -hex 32). 바꾸면 기존 로그인이 모두 풀린다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/kakao/callback
# 앱 로그인(POST /api/auth/kakao/token)용 카카오 앱 ID(숫자). 콘솔의 앱 정보에 있다.
# 비어 있거나 JWT_SECRET이 없으면 앱 로그인만 503이다. 웹 로그인과 같은 카카오 앱이어야 한다.
KAKAO_APP_ID=
JWT_SECRET=
JWT_EXPIRE_SECONDS=1209600
# 사용자·북마크 SQLite 파일. 공지 DB와 달리 크롤링으로 교체되지 않는다.
USER_DB_PATH=./data/users.db
# 사용자당 북마크 상한. 넘으면 PUT /api/bookmarks/{id}가 409를 반환한다.
BOOKMARK_MAX_PER_USER=500
# 사용자에게 렌더되는 공지 본문에서도 학번과 이름을 가릴지 여부. 끄면 본문은
# 원문 그대로 저장되고 검색 인덱스와 LLM 입력만 가려진다. 제목과 첨부파일은
# 어느 쪽이든 건드리지 않는다. docs/PRIVACY_MASKING.md 참고.
PRIVACY_MASK_BODY=true
# 공지 속 사람 이름을 NER 모델로 가릴지 여부. 켜져 있는데 모델 파일이 없으면 오류를
# 낸다. 모델은 python scripts/install_name_model.py <모델 폴더>로 NAME_MODEL_DIR에 넣는다.
PRIVACY_MASK_NAMES=true
NAME_MODEL_DIR=./models/kau-name-ner
# 본문별로 찾은 이름 위치. 크롤링마다 바뀐 본문만 모델을 돌리게 한다.
NAME_MASK_CACHE_PATH=./data/name_mask_cache.db
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_BOOKMARKS=120/minute
