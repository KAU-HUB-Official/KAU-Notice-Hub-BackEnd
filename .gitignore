# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Test and coverage outputs
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging and build outputs
*.egg-info/
.eggs/
build/
dist/
wheelhouse/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
__pypackages__/

# Local environment files
.env
.env.*
!.env.example

# Deployment keys and local credentials
lightsail_deploy_key
lightsail_deploy_key.pub
lightsail_deploy_key*
*_deploy_key
*_deploy_key.pub
*_deploy_key*
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Runtime logs and local process files
*.log
nohup.out
*.pid
.uvicorn.log
.uvicorn.pid

# Local data snapshots
data/*.json
data/*.tmp
data/*.tmp.*
# 실행별 RAGAS 상세 dump는 로컬 전용(요약 이력은 tests/eval/eval_history.csv로 커밋).
data/ragas_runs/
# 평가용 고정 공지 스냅샷. 학번 명단 등 개인정보가 담긴 원문이라 커밋하지 않는다.
data/eval/
!data/.gitkeep

# Local databases
*.sqlite
*.sqlite3
*.db
# SQLite WAL sidecar files (chat_sessions.db uses WAL mode)
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Docker and OS/editor noise
.docker/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

.claude

# Local HTML notes (변경사항 정리 등 학습용)
*.html
notes/*